# AI Providers
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
MISTRAL_API_KEY=your-mistral-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# LiteLLM
# Use a URL-safe value (openssl rand -hex 24). "auto" is filled by ./setup.sh only.
LITELLM_MASTER_KEY=auto
LITELLM_SALT_KEY=auto
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=auto
LITELLM_DB_PASSWORD=auto

# PostgreSQL
# URL-safe (no / @ : #). "auto" is filled by ./setup.sh only.
POSTGRES_PASSWORD=auto

# OpenWebUI
WEBUI_URL=http://localhost:3001
WEBUI_SECRET_KEY=auto
# Used by ./setup.sh to create the first admin and its API key.
# Leave blank to skip that step and create the admin in the UI yourself.
WEBUI_ADMIN_NAME=Admin
WEBUI_ADMIN_EMAIL=admin@localhost
WEBUI_ADMIN_PASSWORD=auto

# Microsoft SSO (Azure AD)
MICROSOFT_CLIENT_ID=your-client-id-here
MICROSOFT_CLIENT_SECRET=your-client-secret-here
MICROSOFT_CLIENT_TENANT_ID=your-tenant-id-here
MICROSOFT_REDIRECT_URI=http://localhost:3001/oauth/microsoft/callback
OPENID_PROVIDER_URL=https://login.microsoftonline.com/your-tenant-id/v2.0/.well-known/openid-configuration

# Langfuse (set after first launch — see README Langfuse Setup section)
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here

# user-sync
# Filled by ./setup.sh after admin signup. Or paste a key from OpenWebUI Settings > Account.
OPENWEBUI_ADMIN_API_KEY=
USER_SYNC_INTERVAL=60
DEFAULT_USER_ROLE=internal_user
# Budget lives on the Team (per OpenWebUI group), not per user.
DEFAULT_TEAM_BUDGET=20

# oauth-revocation (optional, on-demand — see oauth-revocation/README.md)
# DRY_RUN defaults to true (preview only); set to false to actually apply revocations.
OAUTH_REVOCATION_DRY_RUN=true

# 127.0.0.1 keeps the stack off the LAN. Set 0.0.0.0 only if other machines must reach it.
BIND_HOST=127.0.0.1

# Host ports (container ports stay fixed)
OPENWEBUI_HOST_PORT=3001
LITELLM_HOST_PORT=4000
LITELLM_ECOLOGITS_HOST_PORT=4001
LITELLM_COST_HOST_PORT=4002
LANGFUSE_HOST_PORT=3002
LANGFUSE_URL=http://localhost:3002
N8N_HOST_PORT=5679
N8N_EDITOR_BASE_URL=http://localhost:5679
POSTGRES_HOST_PORT=5434
MCPO_HOST_PORT=8001
